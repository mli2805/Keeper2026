<UserControl x:Class="KeeperWpf.GoldRatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:gl="clr-namespace:System.Globalization;assembly=mscorlib"
             xmlns:local="clr-namespace:KeeperWpf"
             xmlns:cal="http://www.caliburnproject.org"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             cal:Bind.ModelWithoutContext="{Binding .}"
             mc:Ignorable="d" FontSize="14"
             >
      <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="10">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Ввести новые или изменить существующие" VerticalAlignment="Center"/>
                    <TextBlock Text="дату и цену золота 900-й пробы и нажать " VerticalAlignment="Center"/>

                </StackPanel>
                <Button Name="Recount" Content="Сохранить все" Margin="5,4,0,0" Width="120" Height="24"></Button>
            </StackPanel>
            <TextBlock>
                <Hyperlink NavigateUri="http://www.minfin.gov.by/ru/activities_jewels/fund/pokupka/fizlic/archive/" RequestNavigate="HandleLinkClick"> 
                    Архив скупочных цен на драгметаллы на сайте Минфина
                </Hyperlink>
            </TextBlock>
            <TextBlock Text="Цены на монеты исходя из веса 5-ки - 3.87 г и 10-ки - 7.74 г"/>
            <TextBlock Text="Цены в рублях фиксированы. "/>
            <TextBlock Text="Для определения цены в долларах в произвольный день рублевая цена переводится в доллары по `моему` курсу "/>
        </StackPanel>
        <local:MyDataGrid ItemsSource="{Binding Rows}" 
                          AutoGenerateColumns="False" SelectionMode="Single" Margin="5">
            <i:Interaction.Behaviors>
                <local:ScrollToBottomOnAddBehavior />
                <local:ScrollToBottomOnLoadBehavior />
            </i:Interaction.Behaviors>
            <DataGrid.Columns>
                <local:DgCenterAlignedColumn Header="№" Binding="{Binding Id}" Width="30"/>
                <local:DgRightAlignedColumn Header="Дата" Width="110"
                       Binding="{Binding Date, StringFormat='{}{0:d MMM yyyy}', 
                            ConverterCulture={x:Static gl:CultureInfo.CurrentCulture}}" />

                <DataGridTemplateColumn Header="Minfin (byn)" Width="90">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding MinfinGold900Rate, StringFormat={}{0:0.################}, 
                                    ConverterCulture=en-US}" TextAlignment="Right" Margin="0,0,5,0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <local:FlexibleNumericTextBox 
                                Value="{Binding MinfinGold900Rate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                TextAlignment="Right" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="НБ byn / usd" Width="90">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding BynUsd, StringFormat='{}{0:0.0000}'}" 
                                       TextAlignment="Right" Margin="0,0,5,0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <local:FlexibleNumericTextBox Value="{Binding BynUsd, Mode=TwoWay, 
                                    UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <local:DgRightAlignedColumn Header="Minfin (usd)" Width="90" 
                                            Binding="{Binding MinfinUsd, StringFormat='{}{0:0.00}'}"/>
                <local:DgRightAlignedColumn Header="5-ка (byn)" Width="90"
                                            Binding="{Binding G5RubRate, StringFormat='{}{0:0.00}'}"/>
                <local:DgRightAlignedColumn Header="5-ка (usd)" Width="90"
                                            Binding="{Binding G5RubUsd, StringFormat='{}{0:0.00}'}"/>
                <local:DgRightAlignedColumn Header="10-ка (byn)"  Width="90"
                                            Binding="{Binding G10RubRate, StringFormat='{}{0:0,0.00}', 
                                                ConverterCulture={x:Static gl:CultureInfo.CurrentCulture}}"/>
                <local:DgRightAlignedColumn Header="10-ка (usd)" 
                                    Binding="{Binding G10RubUsd, StringFormat='{}{0:0.00}'}" Width="90"/>
            </DataGrid.Columns>
        </local:MyDataGrid>
    </DockPanel>
</UserControl>
