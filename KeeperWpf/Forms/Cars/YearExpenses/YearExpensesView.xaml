<Window x:Class="KeeperWpf.YearExpensesView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:keeperWpf="clr-namespace:KeeperWpf"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance keeperWpf:YearExpensesViewModel}"
        SizeToContent="WidthAndHeight" FontSize="14" WindowStartupLocation="CenterScreen">
    <DockPanel Margin="5">
        <TextBlock DockPanel.Dock="Top" Text="{Binding Title}"  Margin="5"/>
        <Button DockPanel.Dock="Bottom" Content="Закрыть" Width="120" Height="28" Margin="5" Name="CloseView" HorizontalAlignment="Right"/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="5,0,5,5">
            <TextBlock Text="Итого:"  Margin="0,0,10,0"/>
            <TextBlock Text="{Binding CategoryTotalUsd, StringFormat=N2}" />
            <TextBlock Text=" $" />
        </StackPanel>
        <DataGrid DockPanel.Dock="Bottom" ItemsSource="{Binding CategorySummaries}" Margin="5"
                  IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single" Height="180">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Категория" Width="280" Binding="{Binding CategoryName}"/>
                <keeperWpf:DgRightAlignedColumn Header="$ сумма" Width="100" 
                                                Binding="{Binding TotalUsd, StringFormat=N2}"/>
                <keeperWpf:DgRightAlignedColumn Header="%" Width="60" Binding="{Binding Percent, StringFormat=N1}"/>
            </DataGrid.Columns>
        </DataGrid>
        <DataGrid ItemsSource="{Binding Expenses}" Margin="5,5,5,20" Height="410"
                  IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Дата" Width="90" Binding="{Binding Timestamp, StringFormat='{}{0:dd.MM.yyyy}'}"/>
                <DataGridTextColumn Header="Категория" Width="270" Binding="{Binding Category.Name}"/>
                <keeperWpf:DgRightAlignedColumn Header="Сумма" Width="80" 
                                                Binding="{Binding Amount, StringFormat=N2}"/>
                <keeperWpf:DgCenterAlignedColumn Header="Валюта" Width="50" Binding="{Binding Currency}"/>
                <keeperWpf:DgRightAlignedColumn Header="Сумма, $" Width="70" 
                                    Binding="{Binding AmountInUsd, StringFormat=N2}"/>
                <DataGridTemplateColumn Header="Комментарий" Width="600">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Comment}" TextWrapping="Wrap"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
