<Window x:Class="KeeperWpf.CarsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:keeperWpf="clr-namespace:KeeperWpf"
        xmlns:keeperModels="clr-namespace:KeeperModels;assembly=KeeperModels"
        xmlns:cal="http://www.caliburnproject.org"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance keeperWpf:CarsViewModel}"
     FontSize="14" SizeToContent="Width"  Height="800" WindowStartupLocation="CenterScreen">
    <DockPanel Margin="5">
        <Border DockPanel.Dock="Top" BorderBrush="Gray" BorderThickness="1" Margin="5">
            <DockPanel >
                <keeperWpf:MyDataGrid x:Name="AllCarsTable" DockPanel.Dock="Top" ItemsSource="{Binding Cars}" 
                  SelectedItem="{Binding SelectedCar, Mode=TwoWay}" 
                  AutoGenerateColumns="False" IsReadOnly="True" 
                  cal:Message.Attach="[Event MouseDoubleClick] = [Action EditCar]"
                  Margin="5" SelectionMode="Single">
                    <keeperWpf:MyDataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Изменить (DblClick)" 
                                      cal:Message.Attach="[Event Click] = [Action EditCar]"
                                      BorderBrush="{x:Null}" Background="White" />
                            <MenuItem Header="Добавь новую" 
                                      cal:Message.Attach="[Event Click] = [Action AddNewCar]"
                                      BorderBrush="{x:Null}" Background="White" />
                        </ContextMenu>
                    </keeperWpf:MyDataGrid.ContextMenu>
                    <keeperWpf:MyDataGrid.Columns>
                        <DataGridTextColumn Header="Машина" Binding="{Binding Title}" Width="250"/>
                        <keeperWpf:DgCenterAlignedColumn Header="г.в." Binding="{Binding IssueYear}" Width="45"/>

                        <keeperWpf:DgCenterAlignedColumn Header="покупка" Width="95" 
                           Binding="{Binding PurchaseDate, StringFormat='{}{0:d/MM/yyyy}'}"/>
                        <keeperWpf:DgRightAlignedColumn Header="одометр" Width="70"
                           Binding="{Binding PurchaseMileage, StringFormat={}{0:# ###}}"/>
                        <keeperWpf:DgRightAlignedColumn Header="цена" Width="60" 
                           Binding="{Binding PurchasePrice, StringFormat={}{0:# ###}}"/>

                        <keeperWpf:DgCenterAlignedColumn Header="продажа" Width="95" 
                           Binding="{Binding SaleDate, StringFormat='{}{0:d/MM/yyyy}'}"/>
                        <keeperWpf:DgRightAlignedColumn Header="одометр" Width="70" 
                           Binding="{Binding SaleMileage, StringFormat={}{0:# ###}}"/>
                        <keeperWpf:DgRightAlignedColumn Header="цена" Width="60" 
                            Binding="{Binding SalePrice, StringFormat={}{0:# ###}}"/>

                        <keeperWpf:DgRightAlignedColumn Header="пробег" Width="70" 
                           Binding="{Binding MileageDifference, StringFormat={}{0:# ###}}"/>
                        <keeperWpf:DgRightAlignedColumn Header="км/день" Width="60" 
                           Binding="{Binding MileageAday}"/>
                    </keeperWpf:MyDataGrid.Columns>
                </keeperWpf:MyDataGrid>
                <TextBlock Margin="10,0,10,5" Text="{Binding SelectedCar.Comment}"/>
            </DockPanel>
        </Border>
        <Border BorderBrush="Gray" BorderThickness="1" Margin="5" Padding="5,0">
            <DockPanel DockPanel.Dock="Left" >
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                    <TextBlock Text="{Binding SelectedCar.Title}" 
                               HorizontalAlignment="Left" Margin="5" Width="250"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                    <StackPanel  Orientation="Horizontal">
                        <TextBlock Text="VIN:" Margin="20,0,5,5" Width="25"/>
                        <TextBox IsReadOnly="true" BorderThickness="0" 
                                 Text="{Binding SelectedCar.Vin}" Margin="5,0" Width="150"/>
                    </StackPanel>
                    <StackPanel  Orientation="Horizontal">
                        <TextBlock Text="Номер:" Margin="20,0,5,5" Width="45"/>
                        <TextBlock Text="{Binding SelectedCar.StateRegNumber}" Margin="5,0" Width="80"/>
                    </StackPanel>
                </StackPanel>

                <DataGrid Name="OneCarYearsTable" DockPanel.Dock="Top" ItemsSource="{Binding YearMileagesToShow}" 
                          SelectedItem="{Binding SelectedYearMileage, Mode=TwoWay}"
                          Margin="5,0,5,5"  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                          HorizontalGridLinesBrush="LightGray" VerticalGridLinesBrush="LavenderBlush" >
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Расходы за год" cal:Message.Attach="ShowYearExpenses" />
                            <MenuItem Header="Начать новый год" IsEnabled="{Binding CanStartNewYearMileage}"
                                      cal:Message.Attach="StartNewYearMileage" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="ContentTemplate">
                                <Setter.Value>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" 
                                                   TextWrapping="Wrap" 
                                                   TextAlignment="Center"
                                                   Padding="0"/>
                                    </DataTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>

                    </DataGrid.Resources>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Foreground" Value="Black" />
                                    <Setter Property="BorderThickness" Value="0" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.ItemContainerStyle>
                        <Style TargetType="{x:Type DataGridRow}">
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                            <Setter Property="Foreground" Value="Black" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#B6E6FF" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.ItemContainerStyle>
                    <DataGrid.Columns>
                        <keeperWpf:DgCenterAlignedColumn Header="#" Width="30" Binding="{Binding YearNumber}"/>
                        <keeperWpf:DgCenterAlignedColumn Header="год" Width="160" Binding="{Binding FromTo}"/>
                        <keeperWpf:DgRightAlignedColumn Header="пробег за год" Width="60" 
                                            Binding="{Binding Mileage, StringFormat={}{0:# ###}}"/>
                        <keeperWpf:DgRightAlignedColumn Header="одометр" Width="70" 
                                            Binding="{Binding Odometer, StringFormat={}{0:# ###}}"/>
                        <keeperWpf:DgRightAlignedColumn Header="$ сумма за год" Width="65" 
                                            Binding="{Binding YearAmount, StringFormat={}{0:# ###.0}}"/>
                        <keeperWpf:DgRightAlignedColumn Header="$ сумма в день" Width="65" 
                                            Binding="{Binding DayAmount, StringFormat=N1}"/>
                        <keeperWpf:DgRightAlignedColumn Header="$ цена за км" Width="60" 
                                            Binding="{Binding PricePerKm, StringFormat=N2}"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock DockPanel.Dock="Top" Margin="10,0" Text="* суммы по годам без учета покупки-продажи"/>
                <StackPanel DockPanel.Dock="Bottom" Margin="5,0,5,20">
                    <TextBlock Text="Итого:" FontWeight="Bold"/>
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <TextBlock Margin="10,0,0,0" Text="{Binding Total.FromTo}"/>
                        <TextBlock Margin="15,0, 2,0" Text="{Binding Total.Mileage, StringFormat={}{0:# ###}}"/>
                        <TextBlock Text="км"/>

                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <TextBlock Text="Расходы на авто:" Width="200"/>
                        <TextBlock Margin="0,0, 2, 0" Width="50" TextAlignment="Right"
                                   Text="{Binding Total.YearAmount, StringFormat={}{0:# ###}}"/>
                        <TextBlock Text="$"/>
                        <TextBlock Margin="0,0, 2, 0"  Width="50" TextAlignment="Right"
                                   Text="{Binding Total.DayAmount, StringFormat=N1}"/>
                        <TextBlock Text="$ в день"/>
                        <TextBlock Margin="0,0, 2, 0"  Width="50" TextAlignment="Right"
                                   Text="{Binding Total.PricePerKm, StringFormat=N2}"/>
                        <TextBlock Text="$ за км"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <TextBlock Text="С учетом покупки-продажи:"  Width="200"/>
                        <TextBlock Margin="0,0, 2, 0"  Width="50" TextAlignment="Right"
                                   Text="{Binding TotalPlus.YearAmount, StringFormat={}{0:# ###}}"/>
                        <TextBlock Text="$"/>
                        <TextBlock Margin="0,0, 2, 0"  Width="50" TextAlignment="Right"
                                   Text="{Binding TotalPlus.DayAmount, StringFormat=N1}"/>
                        <TextBlock Text="$ в день"/>
                        <TextBlock Margin="0,0, 2, 0"  Width="50" TextAlignment="Right"
                                   Text="{Binding TotalPlus.PricePerKm, StringFormat=N2}"/>
                        <TextBlock Text="$ за км"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel></StackPanel>
            </DockPanel>
        </Border>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Vertical" HorizontalAlignment="Right" Margin="5" Width="200" >
            <Button Name="ShowOwnershipCostChart" Height="48"  Margin="5" >
                <TextBlock Margin="10,0" TextWrapping="Wrap" Text="График стоимости владения" TextAlignment="Center"/>
            </Button>
            <Button  Content="Закрыть" Margin=" 5" Height="28" Name="CloseView" />
        </StackPanel>
        <Border DockPanel.Dock="Bottom"  Width="200" Margin="5,5,5,50"  HorizontalAlignment="Right"  
                BorderBrush="Gray" BorderThickness="1" >
            <StackPanel Orientation="Vertical" Margin="5" >
                <CheckBox IsChecked="{Binding IsAggregateCategories}" Margin="5" >
                    <TextBlock Text="Объединять категории" TextWrapping="Wrap"/>
                </CheckBox>
                <CheckBox IsChecked="{Binding DrawFuelTable}" Margin="5" >
                    <TextBlock Text="Выводить таблицу топлива" TextWrapping="Wrap"/>
                </CheckBox>
                <CheckBox IsChecked="{Binding IsBynInReport}" Margin="5" >
                    <TextBlock Text="Показывать суммы в рублях" TextWrapping="Wrap"/>
                </CheckBox>
                <Button Content="Авто отчет" Width="180" Height="28" Margin="0,5" Name="ShowCarReport" 
                    ToolTip="Разделы отчета ищутся по русским словам в имени категории." />
            </StackPanel>
        </Border>
        <StackPanel Margin="5,20" Width="200"   HorizontalAlignment="Right">
            <Button Content="Заправка" Margin="5" Height="28" Name="Fuelling"/>
            <Button Content="Отчет по кредиту" Margin="5" Height="28" Name="CarLoanReport"/>
        </StackPanel>
    </DockPanel>
</Window>
