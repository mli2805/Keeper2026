<Window x:Class="KeeperWpf.HouseholdBillsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KeeperWpf"
        xmlns:cal="http://www.caliburnproject.org"
        mc:Ignorable="d"
        Title="Коммунальные платежи" Height="800" Width="1150"
        MinHeight="600" MinWidth="850"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,10">
            <TextBlock Text="Каталог JSON:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <Button Content="Выбрать..." DockPanel.Dock="Right" Padding="12,3"
                    cal:Message.Attach="SelectDirectory"/>
            <TextBox Text="{Binding DirectoryPath, Mode=OneWay}"
                     IsReadOnly="True" VerticalContentAlignment="Center" Margin="0,0,8,0"/>
        </DockPanel>

        <local:BillMonthEditorView Grid.Row="1" DataContext="{Binding Editor}"/>
    </Grid>
</Window>
