<Window x:Class="KeeperWpf.BillsParsingView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KeeperWpf"
        xmlns:cal="http://www.caliburnproject.org"
        mc:Ignorable="d"
        Title="Разбор жировок" Height="700" Width="1150"
        MinHeight="800" MinWidth="850"
        Background="White" Foreground="Black" Opacity="1"
        WindowState="Normal" WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize" ShowActivated="True" ShowInTaskbar="True">
    <TabControl Margin="10">
        <TabItem Header="PDF">
    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel>
            <TextBlock Text="Каталог:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <Button Content="Выбрать..." DockPanel.Dock="Right" Padding="12,3"
                    IsEnabled="{Binding CanSelectDirectory}"
                    cal:Message.Attach="SelectDirectory"/>
            <TextBox Text="{Binding DirectoryPath, UpdateSourceTrigger=PropertyChanged}"
                     IsEnabled="{Binding CanSelectDirectory}"
                     VerticalContentAlignment="Center" Margin="0,0,8,0"/>
        </DockPanel>

        <DockPanel Grid.Row="1" Margin="0,10,0,10">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button Content="Разобрать PDF" Padding="14,5" Margin="0,0,8,0"
                        IsEnabled="{Binding CanParse}" cal:Message.Attach="Parse"/>
                <Button Content="Экспорт исходного PDF в CSV" Padding="14,5" Margin="0,0,8,0"
                        IsEnabled="{Binding CanSave}" cal:Message.Attach="Save"/>
                <Button Content="Загрузить CSV" Padding="14,5"
                        IsEnabled="{Binding CanLoad}" cal:Message.Attach="Load"/>
            </StackPanel>
            <ProgressBar Minimum="0" Maximum="{Binding ProgressMaximum}"
                         Value="{Binding ProgressValue, Mode=OneWay}" Height="18" Margin="20,4,0,4"/>
        </DockPanel>

        <local:BillMonthEditorView Grid.Row="2" DataContext="{Binding Editor}"
                                   IsEnabled="{Binding DataContext.CanSelectDirectory, RelativeSource={RelativeSource AncestorType=Grid}}"/>

        <TextBlock Grid.Row="3" Text="{Binding Status}" Margin="0,8,0,4"
                   TextWrapping="Wrap"/>

    </Grid>
        </TabItem>
        <TabItem Header="OCR (JPEG)">
            <Grid Margin="6" DataContext="{Binding Ocr}" cal:Action.TargetWithoutContext="{Binding}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel>
                    <TextBlock Text="Каталог TSV:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button Content="Выбрать..." DockPanel.Dock="Right" Padding="12,3"
                            IsEnabled="{Binding CanSelectDirectory}" cal:Message.Attach="SelectDirectory"/>
                    <TextBox Text="{Binding DirectoryPath, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding CanSelectDirectory}"
                             VerticalContentAlignment="Center" Margin="0,0,8,0"/>
                </DockPanel>
                <DockPanel Grid.Row="1" Margin="0,10,0,10">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <Button Content="Разобрать OCR" Padding="14,5" Margin="0,0,8,0"
                                IsEnabled="{Binding CanParse}" cal:Message.Attach="Parse"/>
                        <Button Content="Экспорт исходного OCR в CSV" Padding="14,5" Margin="0,0,8,0"
                                IsEnabled="{Binding CanSave}" cal:Message.Attach="Save"/>
                        <Button Content="Загрузить CSV" Padding="14,5"
                                IsEnabled="{Binding CanLoad}" cal:Message.Attach="Load"/>
                    </StackPanel>
                    <ProgressBar Minimum="0" Maximum="{Binding ProgressMaximum}"
                                 Value="{Binding ProgressValue, Mode=OneWay}" Height="18" Margin="20,4,0,4"/>
                </DockPanel>
                <local:BillMonthEditorView Grid.Row="2" DataContext="{Binding Editor}"
                                           IsEnabled="{Binding DataContext.CanSelectDirectory, RelativeSource={RelativeSource AncestorType=Grid}}"/>
                <TextBlock Grid.Row="3" Text="{Binding Status}" Margin="0,8,0,4" TextWrapping="Wrap"/>
            </Grid>
        </TabItem>
    </TabControl>
</Window>
