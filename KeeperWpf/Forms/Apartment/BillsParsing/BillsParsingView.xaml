<Window x:Class="KeeperWpf.BillsParsingView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KeeperWpf"
        xmlns:cal="http://www.caliburnproject.org"
        mc:Ignorable="d"
        Title="BillsParsingView" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="10">
            <TextBlock Text="Каталог:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <Button Content="Выбрать..." DockPanel.Dock="Right" Padding="12,3"
                    cal:Message.Attach="SelectDirectory"/>
            <TextBox Text="{Binding DirectoryPath, UpdateSourceTrigger=PropertyChanged}"
                     VerticalContentAlignment="Center" Margin="0,0,8,0"/>
        </DockPanel>
    </Grid>
</Window>
