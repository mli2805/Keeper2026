<UserControl x:Class="KeeperWpf.BillMonthEditorView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:cal="http://www.caliburnproject.org">
 <Grid cal:Action.TargetWithoutContext="{Binding}">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto" />
   <RowDefinition Height="*" />
   <RowDefinition Height="Auto" />
   <RowDefinition Height="Auto" />
   <RowDefinition Height="Auto" />

  </Grid.RowDefinitions>
  <WrapPanel Margin="0,0,0,8">
   <TextBlock Text="Месяц:" VerticalAlignment="Center" Margin="0,0,8,0" />
   <Button Content="◀" ToolTip="Предыдущий месяц" Padding="8,0" Margin="0,0,4,0" IsEnabled="{Binding CanPreviousMonth}" cal:Message.Attach="PreviousMonth" />
   <ComboBox ItemsSource="{Binding Periods}" SelectedItem="{Binding SelectedPeriod}" Width="130" IsEnabled="{Binding CanSelectMonth}">
    <ComboBox.ItemTemplate>
     <DataTemplate>
      <TextBlock Text="{Binding StringFormat='{}{0:yyyy-MM}'}" />
     </DataTemplate>
    </ComboBox.ItemTemplate>
   </ComboBox>
   <Button Content="▶" ToolTip="Следующий месяц" Padding="8,0" Margin="4,0,0,0" IsEnabled="{Binding CanNextMonth}" cal:Message.Attach="NextMonth" />
   <Button Content="Добавить услугу" Margin="8,0" IsEnabled="{Binding CanAddRow}" cal:Message.Attach="AddRow" />
   <Button Content="Скопировать услугу" Margin="0,0,8,0" IsEnabled="{Binding CanCopyRow}" cal:Message.Attach="CopyRow" />
   <Button Content="Удалить строку" IsEnabled="{Binding CanDeleteRow}" cal:Message.Attach="DeleteRow" />
   <Button Content="Из прошлого" Margin="8,0,0,0" IsEnabled="{Binding CanFillFromPrevious}" cal:Message.Attach="FillFromPrevious" />
   <Button Content="Повторить месяц" Margin="8,0,0,0" IsEnabled="{Binding CanRepeatMonth}" cal:Message.Attach="RepeatMonth" />
   <Button Content="Пересчитать" Margin="8,0" IsEnabled="{Binding CanRecalculate}" cal:Message.Attach="Recalculate" />
   <Button Content="Загрузить JSON" IsEnabled="{Binding CanLoadMonth}" cal:Message.Attach="LoadMonth" />
  </WrapPanel>
  <DataGrid x:Name="MonthRows" Grid.Row="1" ItemsSource="{Binding SortedRows}" IsReadOnly="{Binding IsReadOnly}" SelectionUnit="Cell" SelectionMode="Extended" ClipboardCopyMode="ExcludeHeader" SelectedCellsChanged="MonthRowsSelectedCellsChanged" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False">
   <DataGrid.Columns>
    <DataGridTextColumn Header="Номер" Binding="{Binding Number, UpdateSourceTrigger=PropertyChanged}" Width="60" SortMemberPath="SortNumber" />
    <DataGridTemplateColumn Header="Услуга" Width="*" MinWidth="220" ClipboardContentBinding="{Binding ServiceName}">
     <DataGridTemplateColumn.CellTemplate>
      <DataTemplate>
       <TextBlock Text="{Binding ServiceName}" />
      </DataTemplate>
     </DataGridTemplateColumn.CellTemplate>
     <DataGridTemplateColumn.CellEditingTemplate>
      <DataTemplate>
       <ComboBox IsEditable="True" IsTextSearchEnabled="True" DropDownOpened="ServiceNamesDropDownOpened" ItemsSource="{Binding DataContext.ServiceNames, RelativeSource={RelativeSource AncestorType=DataGrid}}" Text="{Binding ServiceName, UpdateSourceTrigger=PropertyChanged}" />
      </DataTemplate>
     </DataGridTemplateColumn.CellEditingTemplate>
    </DataGridTemplateColumn>
    <DataGridTextColumn Header="Ед." Binding="{Binding Unit, UpdateSourceTrigger=PropertyChanged}" Width="70" />
    <DataGridTextColumn Header="Объем" Binding="{Binding Volume, UpdateSourceTrigger=PropertyChanged}" Width="100" />
    <DataGridTextColumn Header="Тариф" Binding="{Binding Tariff, UpdateSourceTrigger=PropertyChanged}" Width="100" />
    <DataGridTextColumn Header="Начислено" Binding="{Binding Charged, UpdateSourceTrigger=PropertyChanged}" Width="110" />
    <DataGridTextColumn Header="Перерасчет" Binding="{Binding Recalculation, UpdateSourceTrigger=PropertyChanged}" Width="110" />
    <DataGridTextColumn Header="Итого" Binding="{Binding Total, UpdateSourceTrigger=PropertyChanged}" Width="110" />
   </DataGrid.Columns>
  </DataGrid>
  <StackPanel Grid.Row="2" Margin="0,8,0,6">
   <StackPanel Orientation="Horizontal" Margin="0,0,0,6"><TextBlock Text="Сумма колонки «Итого»:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0" /><TextBox x:Name="ColumnTotalValue" Text="{Binding ColumnTotal, Mode=OneWay}" IsReadOnly="True" FontWeight="Bold" Width="160" /></StackPanel>
   <WrapPanel>
   <Grid>
    <Grid.Resources>
     <Style TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,2,12,2" />
     </Style>
     <Style TargetType="TextBox">
      <Setter Property="Margin" Value="0,2" />
      <Setter Property="IsReadOnly" Value="{Binding IsReadOnly}" />
     </Style>
    </Grid.Resources>
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="270" />
     <ColumnDefinition Width="160" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
     <RowDefinition Height="Auto" />
     <RowDefinition Height="Auto" />
     <RowDefinition Height="Auto" />
     <RowDefinition Height="Auto" />
     <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Text="Итого начислено" />
    <TextBox Grid.Column="1" Text="{Binding Footer.TotalAccrued, UpdateSourceTrigger=PropertyChanged}" />
    <TextBlock Grid.Row="1" Text="Переходящий остаток" />
    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Footer.Carryover, UpdateSourceTrigger=PropertyChanged}" />
    <TextBlock Grid.Row="2" Text="Пеня" />
    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Footer.Penalty, UpdateSourceTrigger=PropertyChanged}" />
    <TextBlock Grid.Row="3" Text="Возмещение земельного налога" />
    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Footer.LandTax, UpdateSourceTrigger=PropertyChanged}" />
    <TextBlock Grid.Row="4" Text="Всего к оплате" />
    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Footer.TotalDue, UpdateSourceTrigger=PropertyChanged}" />
   </Grid>
   <Grid Margin="24,0,0,0">
    <Grid.Resources>
     <Style TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="4,2" />
     </Style>
     <Style TargetType="TextBox">
      <Setter Property="Margin" Value="4,2" />
      <Setter Property="IsReadOnly" Value="True" />
     </Style>
    </Grid.Resources>
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="150" />
     <ColumnDefinition Width="100" />
     <ColumnDefinition Width="100" />
     <ColumnDefinition Width="100" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
     <RowDefinition Height="Auto" />
     <RowDefinition Height="Auto" />
     <RowDefinition Height="Auto" />
     <RowDefinition Height="Auto" />
     <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Text="Счетчики" FontWeight="Bold" />
    <TextBlock Grid.Column="1" Text="От" />
    <TextBlock Grid.Column="2" Text="До" />
    <TextBlock Grid.Column="3" Text="Объем" />
    <TextBlock Grid.Row="1" Text="Холодная вода, м³" />
    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding UtilityMeters.ColdWater.From, Mode=OneWay}" />
    <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding UtilityMeters.ColdWater.To, Mode=OneWay}" />
    <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding UtilityMeters.ColdWater.Volume, Mode=OneWay}" />
    <TextBlock Grid.Row="2" Text="Горячая вода, м³" />
    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding UtilityMeters.HotWater.From, Mode=OneWay}" />
    <TextBox Grid.Row="2" Grid.Column="2" Text="{Binding UtilityMeters.HotWater.To, Mode=OneWay}" />
    <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding UtilityMeters.HotWater.Volume, Mode=OneWay}" />
    <TextBlock Grid.Row="3" Text="Электричество, кВт·ч" />
    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding UtilityMeters.Electricity.From, Mode=OneWay}" />
    <TextBox Grid.Row="3" Grid.Column="2" Text="{Binding UtilityMeters.Electricity.To, Mode=OneWay}" />
    <TextBox Grid.Row="3" Grid.Column="3" Text="{Binding UtilityMeters.Electricity.Volume, Mode=OneWay}" />
    <TextBlock Grid.Row="4" Text="Газ, м³" />
    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding UtilityMeters.Gas.From, Mode=OneWay}" />
    <TextBox Grid.Row="4" Grid.Column="2" Text="{Binding UtilityMeters.Gas.To, Mode=OneWay}" />
    <TextBox Grid.Row="4" Grid.Column="3" Text="{Binding UtilityMeters.Gas.Volume, Mode=OneWay}" />
   </Grid>
   </WrapPanel>
  </StackPanel>
  <StackPanel Grid.Row="3">
   <TextBlock Text="{Binding Reconciliation}" TextWrapping="Wrap" />
   <TextBlock Text="{Binding PaymentReference}" TextWrapping="Wrap" Margin="0,4" />
   <TextBlock Text="{Binding ValidationMessage}" Foreground="DarkRed" TextWrapping="Wrap" />
  </StackPanel>
  <TextBlock Grid.Row="4" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,4" />
 </Grid>
</UserControl>