<Window x:Class="KeeperWpf.HouseholdTransactionsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:keeperWpf="clr-namespace:KeeperWpf"
        mc:Ignorable="d" Width="520" Height="900" WindowStartupLocation="CenterScreen" 
        Background="#FFFFF8F8"
        >
    <Window.Resources>
        <ResourceDictionary>
            <keeperWpf:DoubleToStringConverter x:Key="DoubleToStringConverter" />
        </ResourceDictionary>
    </Window.Resources>
    <StackPanel Margin="10" >
        <keeperWpf:AccNameSelectorView DataContext="{Binding MyAccNameSelectorVm}" 
                                        Margin="10,0" HorizontalAlignment="Stretch"/>
        <StackPanel Orientation="Horizontal">
            <ComboBox ItemsSource="{Binding PaymentWays}" SelectedItem="{Binding SelectedPaymentWay, Mode=TwoWay}" 
                   Width="190" HorizontalAlignment="Left" Margin="10,0,0,0" Height="22" IsEnabled="False"/>
            <Label Content="{Binding MyAccountBalance}" Height="30" HorizontalAlignment="Left" Margin="50,0,0,0"/>
        </StackPanel>

        <ItemsControl ItemsSource="{Binding PaymentTemplates}" Margin="10,20,10,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,2,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <CheckBox Grid.Column="0" IsChecked="{Binding IsOn, Mode=TwoWay}"
                          VerticalAlignment="Center"
                          Margin="0,0,10,0"/>

                        <TextBox Grid.Column="1" Height="20" Width="70" BorderBrush="#555555" 
                                 TextAlignment="Right" Foreground="Red"
                                 Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged, 
                                    Converter={StaticResource DoubleToStringConverter}}" />
                        
                        <TextBlock Grid.Column="2" Text="{Binding Currency}"/>
                        <TextBlock Grid.Column="3" Text="{Binding Kor}"/>

                        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" Height="37">
                            <TextBox Margin="0,4,0,0" Height="20" BorderBrush="#555555" 
                                Text="{Binding Comment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"                    />
                        </StackPanel>

                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <DockPanel Margin="10,20,0,2">
            <keeperWpf:DatePickerWithTriangles DataContext="{Binding MyDatePickerVm}" />
        </DockPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Name="Save" Content="Сохранить " Width="100" Height="22" />
            <Button Name="Cancel" Content="Отменить" Width="100" Height="22" Margin="10,0"/>
        </StackPanel>
    </StackPanel>
</Window>
