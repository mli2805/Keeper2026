<Window x:Class="KeeperWpf.LoanPaymentView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KeeperWpf" 
        d:DataContext="{d:DesignInstance Type=local:LoanPaymentViewModel}"
        mc:Ignorable="d" FontSize="14"
        SizeToContent="WidthAndHeight" WindowStartupLocation="CenterScreen">
    <StackPanel Margin="10,5">
        <StackPanel Orientation="Horizontal" Margin="10" > 
            <TextBlock Text="Реквизиты ЕРИП:" Margin="0,0,10,0"/>
            <TextBox Text="SW/70999" IsReadOnly="True" BorderThickness="0" FontWeight="Medium"/>
        </StackPanel>
        <local:AccNameSelectorView DataContext="{Binding MyAccNameSelectorVm}" 
                                            Width="400" Margin="10,10" HorizontalAlignment="Left"/>
        <Label Content="{Binding MyAccountBalanceStr}" Height="30" HorizontalAlignment="Left" 
                    Margin="250,-15,15,0" Foreground="Gray" FontSize="12"/>
        <StackPanel Orientation="Horizontal" Margin="10" >
            <TextBlock Text="Дата проводки" Width="100" Margin="0,0,10,0" VerticalAlignment="Center"/>
            <local:DatePickerWithTriangles DataContext="{Binding MyDatePickerVm}" Margin="0" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="10">
            <TextBlock Text="Платёж" Width="100" Margin="0,0,10,0"/>
            <local:FlexibleNumericTextBox Width="100" 
                       Value="{Binding TranInWork.Amount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Text="руб" Margin="10,0,0,0"></TextBlock>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="10">
            <TextBlock Text="Тело кредита" Width="100" Margin="0,0,10,0"/>
            <local:FlexibleNumericTextBox Width="100" 
                       Value="{Binding AmountBody, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Text="руб" Margin="10,0,0,0"></TextBlock>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="10">
            <TextBlock Width="100" Text="Комментарий" Margin="0,0,10,0" />
            <TextBox Width="290" Height="42" Text="{Binding Comment1}" HorizontalAlignment="Left"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="10">
            <TextBlock Text="%% по кредиту" Width="100" Margin="0,0,10,0"/>
            <local:FlexibleNumericTextBox Width="100" 
                       Value="{Binding AmountInterest, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Text="руб" Margin="10,0,0,0"></TextBlock>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="10">
            <TextBlock Width="100" Text="Комментарий" Margin="0,0,10,0"/>
            <TextBox Width="290" Height="42" Text="{Binding Comment2}" HorizontalAlignment="Left"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0, 20, 10 ,10">
            <Button Name="Save" Margin="5" Width="100" Content="Сохранить" IsDefault="True"/>
            <Button Name="Cancel" Margin="5" Width="100" Content="Отмена" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
