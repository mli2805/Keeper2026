<Window x:Class="KeeperWpf.OpenDepositsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KeeperWpf"
        mc:Ignorable="d"
        SizeToContent="WidthAndHeight" WindowStartupLocation="CenterScreen" 
        d:DataContext="{d:DesignInstance local:OpenDepositsViewModel}">
    <DockPanel>
        <DataGrid DockPanel.Dock="Bottom" Margin="5" ItemsSource="{Binding Totals}"
                  IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single">
            <DataGrid.ItemContainerStyle>
                <Style TargetType="{x:Type DataGridRow}">
                    <Setter Property="Background" Value="{Binding Fs}" />
                </Style>
            </DataGrid.ItemContainerStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="" Width="70" />
                <local:DgRightAlignedColumn Header="" Width="60" Binding="{Binding Depo.PiecesStr}" />

                <local:DgRightAlignedColumn Header="Депо" Width="100" Binding="{Binding Depo.SumStr}" />
                <local:DgRightAlignedColumn Header="" Width="100" Binding="{Binding Depo.SumUsdStr}" />
                <local:DgRightAlignedColumn Header="" Width="60" Binding="{Binding Depo.PercentStr}" />

                <DataGridTextColumn Header="" Width="104" />
                <local:DgRightAlignedColumn Header="Депо и шкаф" Width="100" Binding="{Binding DepoAndMatras.SumStr}" />
                <local:DgRightAlignedColumn Header="" Width="100" Binding="{Binding DepoAndMatras.SumUsdStr}" />
                <local:DgRightAlignedColumn Header="" Width="60"  Binding="{Binding DepoAndMatras.PercentStr}" />


                <DataGridTextColumn Header="" Width="130" />
                <local:DgRightAlignedColumn Header="Все (депо + шкаф + карточки)" Width="100" Binding="{Binding AllMine.SumStr}" />
                <local:DgRightAlignedColumn Header="" Width="100" Binding="{Binding AllMine.SumUsdStr}" />
                <local:DgRightAlignedColumn Header="" Width="60"  Binding="{Binding AllMine.PercentStr}" />
            </DataGrid.Columns>

        </DataGrid>
        <DataGrid Margin="0,5,5,5" ItemsSource="{Binding Rows}" 
                  IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single">
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="Black" />
                            <Setter Property="BorderThickness" Value="0" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.CellStyle>
            <DataGrid.ItemContainerStyle>
                <Style TargetType="{x:Type DataGridRow}">
                    <Setter Property="Background" Value="{Binding BackgroundBrush}" />
                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#B6E6FF" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.ItemContainerStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Банк" Width="60" Binding="{Binding BankName}" />
                <DataGridTextColumn Header="  Депозит" Width="450" Binding="{Binding DepoName}" />
                <local:DgCenterAlignedColumn Header="Валюта" Width="50" Binding="{Binding MainCurrency}" />
                <local:DgCenterAlignedColumn Header="  Тип ставки" Width="100" Binding="{Binding RateTypeStr}" />
                <local:DgRightAlignedColumn Header="Ставка" Width="50" Binding="{Binding Rate}" />
                <DataGridTextColumn Header="  Допы" Width="140" Binding="{Binding AdditionsStr}" />
                <DataGridTextColumn Header=" c" Width="80" Binding="{Binding StartDate, StringFormat='dd\/MM\/yyyy'}" />
                <DataGridTextColumn Header=" по" Width="100"
                                    Binding="{Binding FinishDate, StringFormat='dd\/MM\/yyyy ddd', ConverterCulture=ru-RU}" />
                <local:DgRightAlignedColumn Header="  Остаток" Width="120" Binding="{Binding Balance}" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
