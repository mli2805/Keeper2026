<UserControl x:Class="KeeperWpf.OneMoneyBackRulesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:KeeperWpf"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:OneMoneyBackRulesViewModel}"
             Width="1000">
    <UserControl.Resources>
        <local:MoneyBackTypeToDisplayConverter x:Key="MoneyBackTypeToDisplayConverter"/>
    </UserControl.Resources>
    <ContentControl>
        <Border BorderBrush="DarkGray" BorderThickness="1" CornerRadius="1" Margin="5">
            <StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10">
                    <TextBlock Text="Действует с" VerticalAlignment="Center" Width="100"/>
                    <DatePicker SelectedDate="{Binding StartDate}" Width="120" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10">
                    <TextBlock Text="Тип манибэка" VerticalAlignment="Center" Width="100"/>
                    <ComboBox ItemsSource="{Binding MoneyBackTypes}"
                              SelectedItem="{Binding MoneyBackType}"
                              Width="180" VerticalAlignment="Center">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource MoneyBackTypeToDisplayConverter}}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <local:CategoriesMoneyBackControl DataContext="{Binding CategoriesControl}"
                                                  Margin="10,0,10,0" Height="200"/>
                <local:PartnersMoneyBackControl DataContext="{Binding PartnersControl}" 
                                                Margin="10,10,10,0" Height="100"/>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10">
                    <TextBlock Text="Процент" VerticalAlignment="Center" Width="100"/>
                    <TextBox Text="{Binding Percent, UpdateSourceTrigger=PropertyChanged}"
                             Width="70" TextAlignment="Right" VerticalAlignment="Center"/>
                </StackPanel>

                <local:NullableNumericControlView DataContext="{Binding MinPurchaseAmountControl}"/>
                <local:NullableNumericControlView DataContext="{Binding MaxPurchaseAmountControl}"/>
                <local:NullableNumericControlView DataContext="{Binding MaxMoneyBackAmountControl}"/>
                <local:NullableNumericControlView DataContext="{Binding MinMonthPurchasesAmountControl}"/>
            </StackPanel>
        </Border>

    </ContentControl>
</UserControl>
