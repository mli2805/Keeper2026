<UserControl x:Class="KeeperWpf.OneMoneyBackRulesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:KeeperWpf"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:OneMoneyBackRulesViewModel}"
             Width="1000">
    <UserControl.Resources>
        <local:MoneyBackTypeToDisplayConverter x:Key="MoneyBackTypeToDisplayConverter"/>
    </UserControl.Resources>
    <ContentControl>
        <Border BorderBrush="DarkGray" BorderThickness="1" CornerRadius="3" Margin="5">
            <StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10">
                    <TextBlock Text="Действует с" VerticalAlignment="Center" Width="100"/>
                    <DatePicker SelectedDate="{Binding StartDate}" Width="120" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                    <TextBlock Text="Тип манибэка" VerticalAlignment="Center" Width="100"/>
                    <ComboBox ItemsSource="{Binding MoneyBackTypes}"
                              SelectedItem="{Binding MoneyBackType}"
                              Width="180" VerticalAlignment="Center">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource MoneyBackTypeToDisplayConverter}}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="Процент" VerticalAlignment="Center" Margin="30,0,10,0"/>
                    <TextBox Text="{Binding Percent, UpdateSourceTrigger=PropertyChanged}"
                            Width="40" Height="22" TextAlignment="Right" VerticalAlignment="Center"/>
                </StackPanel>

                <local:CategoriesMoneyBackControl DataContext="{Binding CategoriesControl}"
                                                  Margin="10,10,10,0" Height="200"/>

                <TextBlock Text="Магазины партнеры" Margin="10,10,10,0"/>
                <local:PartnersMoneyBackControl DataContext="{Binding PartnersControl}" 
                                                Margin="10,10,10,0" Height="100"/>
                <Grid Margin = "10,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <local:NullableNumericControlView Grid.Row="0" Grid.Column="0" 
                                    DataContext="{Binding MinPurchaseAmountControl}"/>
                    <local:NullableNumericControlView Grid.Row="1" Grid.Column="0"  
                                    DataContext="{Binding MaxPurchaseAmountControl}"/>
                    <local:NullableNumericControlView Grid.Row="0" Grid.Column="1" 
                                    DataContext="{Binding MaxMoneyBackAmountControl}"/>
                    <local:NullableNumericControlView Grid.Row="1" Grid.Column="1" 
                                    DataContext="{Binding MinMonthPurchasesAmountControl}"/>

                </Grid>
                <TextBox Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" 
                         Height="70" Margin="10,0,10,10"/>
            </StackPanel>
        </Border>

    </ContentControl>
</UserControl>
