<UserControl x:Class="KeeperWpf.PartnersMoneyBackControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:KeeperWpf"
             mc:Ignorable="d" 
             xmlns:cal="http://www.caliburnproject.org"
             cal:Bind.ModelWithoutContext="{Binding .}"
             d:DesignHeight="450" d:DesignWidth="800" 
                          d:DataContext="{d:DesignInstance Type=local:PartnersMoneyBackControlModel, IsDesignTimeCreatable=True}">
                 <Grid>
                    <DataGrid ItemsSource="{Binding Partners}" AutoGenerateColumns="False"
                              CanUserAddRows="True" CanUserDeleteRows="True"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Процент" Width="60" Binding="{Binding Percent}"/>
                            <DataGridTextColumn Header="Партнер" Width="*" Binding="{Binding Name}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                 </Grid>
             </UserControl>
