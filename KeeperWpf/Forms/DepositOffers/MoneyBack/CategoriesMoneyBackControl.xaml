<UserControl x:Class="KeeperWpf.CategoriesMoneyBackControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:KeeperWpf"
             mc:Ignorable="d" 
             xmlns:cal="http://www.caliburnproject.org"
             cal:Bind.ModelWithoutContext="{Binding .}"
             d:DesignHeight="450" d:DesignWidth="800" 
             d:DataContext="{d:DesignInstance Type=local:CategoriesMoneyBackControlModel, IsDesignTimeCreatable=True}">
    <Grid>
        <DataGrid ItemsSource="{Binding Categories}" AutoGenerateColumns="False"
                  CanUserAddRows="True" CanUserDeleteRows="True"
                  HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Процент" Width="60">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Percent, StringFormat={}{0:0.################}, ConverterCulture=en-US}"
                                       TextAlignment="Right" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <local:FlexibleNumericTextBox Value="{Binding Percent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          TextAlignment="Right"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="MCC" Width="50" Binding="{Binding MCC, TargetNullValue=''}"/>
                <DataGridTextColumn Header="Название" Width="320" Binding="{Binding Name}"/>
                <DataGridTextColumn Header="Описание" Width="*" Binding="{Binding Description}"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
