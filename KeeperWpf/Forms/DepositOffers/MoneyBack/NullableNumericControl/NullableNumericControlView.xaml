<UserControl x:Class="KeeperWpf.NullableNumericControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:KeeperWpf"
             xmlns:cal="http://www.caliburnproject.org"
             mc:Ignorable="d"
             cal:Bind.ModelWithoutContext="{Binding .}"
             d:DataContext="{d:DesignInstance local:NullableNumericControlViewModel}">
    <Border BorderBrush="DarkGray" BorderThickness="1" CornerRadius="3" Margin="2" Padding="6,3">
        <DockPanel VerticalAlignment="Center">
            <TextBlock DockPanel.Dock="Left" Text="{Binding Explanation}" 
                       Margin="5,3,0,0" IsEnabled="{Binding IsSet}"/>
            <local:FlexibleNumericTextBox DockPanel.Dock="Right" Width="60" Height="24" TextAlignment="Right"
                                          IsEnabled="{Binding IsSet}"
                                          Value="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            <CheckBox DockPanel.Dock="Right" IsChecked="{Binding IsSet, Mode=TwoWay}" 
                      VerticalAlignment="Center" Margin="8,0,8,0"/>
            <StackPanel/>
        </DockPanel>
    </Border>
</UserControl>
