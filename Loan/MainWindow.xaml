<Window x:Class="Loan.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Кредит и депозит" Width="1060" SizeToContent="Height"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" Grid.ColumnSpan="5" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4">
            <TextBlock Text="Сумма:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox x:Name="AmountBox" Width="180" TextChanged="OnInputChanged" />
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5" 
                    Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4">
            <TextBlock Text="Дата открытия:" Margin="0,0,8,0" VerticalAlignment="Center" />
            <DatePicker x:Name="OpenDatePicker" Width="140" SelectedDateChanged="OnInputChanged" />
        </StackPanel>

        <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Margin="0,4">
            <TextBlock Text="Полный срок кредита (лет):" Width="190" VerticalAlignment="Center"/>
            <TextBox x:Name="TermYearsBox" Width="140" TextChanged="OnInputChanged"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Grid.Column="0" Orientation="Horizontal" Margin="0,4">
            <TextBlock Text="Ставка по кредиту (% годовых):" Width="190" VerticalAlignment="Center"/>
            <TextBox x:Name="RateBox" Width="140" TextChanged="OnInputChanged"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Grid.Column="2" Orientation="Horizontal" Margin="0,4">
            <TextBlock Text="Ставка по депозиту (%):" Width="170" VerticalAlignment="Center"/>
            <TextBox x:Name="DepositRateBox" Width="140" TextChanged="OnInputChanged"/>
        </StackPanel>

        <GroupBox Grid.Row="5" Grid.ColumnSpan="5" Header="1 год" Margin="0,8,0,4">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="ставка:" VerticalAlignment="Center" Margin="4"/>
                        <TextBox x:Name="Grace1RateBox" Width="70" Margin="4" TextChanged="OnInputChanged"/>
                    </StackPanel>
                    <TextBlock x:Name="Loan1BodyText" Margin="8,2,4,1"/>
                    <TextBlock x:Name="Loan1InterestText" Margin="8,1,4,1"/>
                    <TextBlock x:Name="Loan1TotalText" FontWeight="Bold" Margin="8,1,4,2"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Проценты:"  Margin="4"/>
                    <TextBlock x:Name="Deposit1ResultText" Margin="8,4,4,2"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="6" Grid.ColumnSpan="5" Header="2 года" Margin="0,4">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="ставка:" VerticalAlignment="Center" Margin="4"/>
                        <TextBox x:Name="Grace2RateBox" Width="70" Margin="4" TextChanged="OnInputChanged"/>
                    </StackPanel>
                    <TextBlock x:Name="Loan2BodyText" Margin="8,2,4,1"/>
                    <TextBlock x:Name="Loan2InterestText" Margin="8,1,4,1"/>
                    <TextBlock x:Name="Loan2TotalText" FontWeight="Bold" Margin="8,1,4,2"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="Deposit2ResultText" Margin="8,4,4,2"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="7" Grid.ColumnSpan="5" Header="3 года" Margin="0,4">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="ставка:" VerticalAlignment="Center" Margin="4"/>
                        <TextBox x:Name="Grace3RateBox" Width="70" Margin="4" TextChanged="OnInputChanged"/>
                    </StackPanel>
                    <TextBlock x:Name="Loan3BodyText" Margin="8,2,4,1"/>
                    <TextBlock x:Name="Loan3InterestText" Margin="8,1,4,1"/>
                    <TextBlock x:Name="Loan3TotalText" FontWeight="Bold" Margin="8,1,4,2"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="Deposit3ResultText" Margin="8,4,4,2"/>
                </StackPanel>
            </Grid>
        </GroupBox>
    </Grid>
</Window>
